# Copie ce fichier en .env avant le premier `docker compose up -d`.

# Code du foyer, demandé une fois par navigateur. Sans lui, l'app est ouverte
# à quiconque atteint l'URL.
MIAMSTOCK_PIN=1234

# Open Food Facts demande un User-Agent identifiant l'application.
MIAMSTOCK_USER_AGENT=MiamStock/0.1 (maison)

# Seuils d'alerte, en jours.
MIAMSTOCK_URGENT_DAYS=3
MIAMSTOCK_SOON_DAYS=7

TZ=Europe/Paris

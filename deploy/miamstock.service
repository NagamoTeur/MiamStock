# Alternative à Docker, pour un LXC Debian/Ubuntu nu.
#   sudo cp deploy/miamstock.service /etc/systemd/system/
#   sudo systemctl enable --now miamstock

[Unit]
Description=MiamStock — inventaire alimentaire
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miam
Group=miam
WorkingDirectory=/opt/miamstock
Environment=MIAMSTOCK_DATA_DIR=/var/lib/miamstock
Environment=MIAMSTOCK_WEB_DIST=/opt/miamstock/web/dist
Environment=MIAMSTOCK_HOST=127.0.0.1
Environment=MIAMSTOCK_PORT=8077
EnvironmentFile=-/etc/default/miamstock
ExecStart=/opt/miamstock/.venv/bin/miamstock
Restart=on-failure
RestartSec=5

# Le service n'a besoin d'écrire que dans son répertoire de données.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=miamstock
ReadWritePaths=/var/lib/miamstock

[Install]
WantedBy=multi-user.target

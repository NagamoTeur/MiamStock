# Base et clé de session à la racine uniquement. Sans le « / » initial, la
# règle visait aussi src/miamstock/data/, et la table Ciqual — une donnée
# du programme, pas de l'utilisateur — ne partait jamais dans le dépôt.
/data/
*.egg-info/
.env
*.pyc
__pycache__/
.pytest_cache/
.venv/
web/dist/
web/node_modules/
.tmp-timescale.mjs
# Captures de la revue de finition : preuves d'une exécution, pas des sources.
.impeccable/review/
.impeccable/build/
.impeccable/mocks/
.impeccable/questions/
